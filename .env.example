# Ejemplo de ~/.qagent/.env (C:\Users\<tú>\.qagent\.env). NO pongas claves reales aquí:
# este archivo se versiona. Copia las líneas que necesites a ~/.qagent/.env y completa
# solo ahí el valor. La pantalla Configuración también las guarda por ti.
#
# Una variable por proveedor (src/qagent/llm/proveedores.toml). Para usar una clave
# distinta en cada agente, agrega el sufijo: DEEPSEEK_API_KEY_PLANNER, ..._GENERATOR,
# ..._REVIEWER.
ANTHROPIC_API_KEY=
XIAOMI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# IA simulada, sin claves ni gasto:
# QAGENT_FAKE_LLM=1
