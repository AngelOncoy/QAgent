# Imagen del sandbox para JavaScript y TypeScript: qagent-sandbox:node (#169).
# Solo trae las herramientas de prueba. Las dependencias del proyecto (`npm ci`) van en
# una imagen derivada (paso 1, con red) y las pruebas corren sin red (paso 2).
#
# Dónde queda cada cosa (Node busca `node_modules` subiendo de carpeta en carpeta):
#   /work/proyecto          copia del proyecto, montada al ejecutar
#   /work/node_modules      dependencias del proyecto (imagen derivada, `npm ci`)
#   /node_modules           herramientas de QAgent (enlace a /opt/qagent/node_modules)
# Así el montaje del proyecto no tapa las dependencias, y si el proyecto trae su propio
# Vitest se usa el suyo antes que el de QAgent.
FROM node:26.13.0-trixie-slim

ENV NODE_ENV=test \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    PATH=/work/node_modules/.bin:/opt/qagent/node_modules/.bin:$PATH

# Stryker usa `ps` para vigilar sus procesos; la imagen slim no lo trae.
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/qagent \
    && cd /opt/qagent \
    && npm init -y > /dev/null \
    && npm install --save-exact --no-package-lock \
        vitest@5.0.5 \
        @vitest/coverage-v8@5.0.5 \
        @stryker-mutator/core@10.1.1 \
        @stryker-mutator/vitest-runner@10.1.1 \
        dependency-cruiser@18.6.0 \
        typescript@6.0.3 \
        jsdom@30.1.3 \
        @testing-library/react@16.3.3 \
        @testing-library/dom@10.4.2 \
        @testing-library/jest-dom@7.0.1 \
    && npm cache clean --force \
    && ln -s /opt/qagent/node_modules /node_modules
# Componentes React (#171): Testing Library debe usar el MISMO React que el proyecto
# (dos copias rompen los hooks). npm instala React como dependencia «peer» de
# Testing Library; se borra esa copia y se enlaza a la del proyecto, que la imagen
# derivada instala en /work/node_modules. En proyectos sin React el enlace queda roto
# y no se usa.
RUN cd /opt/qagent/node_modules \
    && rm -rf react react-dom scheduler \
    && ln -s /work/node_modules/react react \
    && ln -s /work/node_modules/react-dom react-dom

# La imagen oficial ya trae el usuario `node` con uid 1000: se renombra a `sandbox`
# para que todas las imágenes del sandbox usen el mismo usuario.
RUN usermod --login sandbox --move-home --home /home/sandbox node \
    && groupmod --new-name sandbox node \
    && mkdir -p /work/proyecto /work/tests /out \
    && chown -R sandbox:sandbox /work /out

USER sandbox
WORKDIR /work
