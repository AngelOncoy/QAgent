{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e_routes.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "framework", "adapter", "start_command", "port", "routes"],
  "properties": {
    "version": {"const": "1"},
    "language": {"enum": ["javascript", "typescript"]},
    "framework": {"enum": ["express", "vite"]},
    "adapter": {"type": "string", "minLength": 1},
    "start_command": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "routes": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "source", "route_type", "eligible", "reason"],
        "properties": {
          "path": {"type": "string", "pattern": "^/(?!/)", "maxLength": 500},
          "source": {"type": "string", "minLength": 1, "maxLength": 500},
          "route_type": {"enum": ["page", "api", "static", "auth"]},
          "eligible": {"type": "boolean"},
          "reason": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    }
  }
}
