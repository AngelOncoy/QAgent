{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture_result.v1",
  "title": "Resultado normalizado de arquitectura",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "lenguaje", "estado", "duracion_s", "reglas"],
  "properties": {
    "version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$"},
    "lenguaje": {"enum": ["python", "javascript", "typescript", "java"]},
    "estado": {"enum": ["cumple", "incumple", "sin_veredicto"]},
    "duracion_s": {"type": "number", "minimum": 0},
    "reglas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resultadoRegla"}
    }
  },
  "$defs": {
    "hallazgo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desde", "hacia", "archivo", "linea"],
      "properties": {
        "desde": {"type": "string", "minLength": 1},
        "hacia": {"type": "string", "minLength": 1},
        "archivo": {"type": ["string", "null"]},
        "linea": {"type": ["integer", "null"], "minimum": 1},
        "cadena": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resultadoRegla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "tipo", "origen", "estado", "herramienta", "hallazgos", "motivo_sin_veredicto"],
      "properties": {
        "id": {"type": "string"},
        "nombre": {"type": "string"},
        "tipo": {"enum": ["ciclos_importacion", "dependencia_prohibida"]},
        "origen": {"enum": ["universal", "usuario", "ia"]},
        "estado": {"enum": ["cumple", "incumple", "sin_veredicto", "no_ejecutada"]},
        "herramienta": {"type": "string", "minLength": 1},
        "hallazgos": {"type": "array", "items": {"$ref": "#/$defs/hallazgo"}},
        "motivo_sin_veredicto": {"type": ["string", "null"]}
      }
    }
  }
}
