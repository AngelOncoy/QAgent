{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_result.schema.json",
  "title": "review_result",
  "description": "Veredicto del Reviewer/Executor sobre un intento: resultado del sandbox, guardrail de laundering y decisión.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "objetivo",
    "intento",
    "estado_sandbox",
    "cobertura",
    "laundering_detectado",
    "tipo_fallo",
    "hash_error",
    "decision",
    "feedback"
  ],
  "properties": {
    "version": { "const": "1" },
    "objetivo": { "type": "string", "minLength": 1 },
    "intento": { "type": "integer", "minimum": 1, "maximum": 3 },
    "estado_sandbox": {
      "enum": ["ok", "fallo", "timeout", "oom", "error"],
      "description": "ok = pytest pasó; fallo = pytest falló; timeout/oom/error = problema del sandbox."
    },
    "cobertura": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineas", "ramas"],
          "properties": {
            "lineas": { "type": "number", "minimum": 0, "maximum": 100 },
            "ramas": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
          }
        }
      ],
      "description": "Porcentajes de coverage.py; null si no se generó coverage.json."
    },
    "laundering_detectado": { "type": "boolean" },
    "tipo_fallo": {
      "enum": ["error_test", "bug_codigo", null],
      "description": "error_test = el test está mal escrito; bug_codigo = el código no cumple lo que declara."
    },
    "hash_error": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8,64}$",
      "description": "Hash del error normalizado; si se repite, la decisión es stalled."
    },
    "decision": { "enum": ["accept", "retry", "bug_detectado", "stalled"] },
    "feedback": { "type": "string" },
    "ejecucion": {
      "description": "EN-17. Lo que pasó en el sandbox en este intento: casos, salida y entorno. Ausente si el test no llegó a ejecutarse (sintaxis, laundering o valor esperado ausente).",
      "$ref": "#/$defs/ejecucion"
    }
  },
  "$defs": {
    "ejecucion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "duracion_s", "salida", "totales", "casos", "entorno"],
      "properties": {
        "exit_code": { "type": ["integer", "null"] },
        "duracion_s": { "type": "number", "minimum": 0 },
        "duracion_pytest_s": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "#115. Tiempo de la suite de pytest según junit.xml; null si no hubo junit."
        },
        "timeout": { "type": "boolean" },
        "oom": { "type": "boolean" },
        "salida": { "type": "string", "description": "stdout y stderr de pytest, recortados." },
        "codigo_test": { "type": ["string", "null"], "description": "El test que se ejecutó en este intento." },
        "totales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "pasaron", "fallaron", "errores", "omitidos"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "pasaron": { "type": "integer", "minimum": 0 },
            "fallaron": { "type": "integer", "minimum": 0 },
            "errores": { "type": "integer", "minimum": 0 },
            "omitidos": { "type": "integer", "minimum": 0 }
          }
        },
        "casos": { "type": "array", "items": { "$ref": "#/$defs/caso" } },
        "lineas_sin_cubrir": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1 },
          "description": "Líneas de la función probada que ningún caso ejecutó; null si no se pudo ubicar."
        },
        "entorno": {
          "type": "object",
          "additionalProperties": false,
          "required": ["imagen", "comando", "limites"],
          "properties": {
            "imagen": { "type": "string" },
            "comando": { "type": "string" },
            "plataforma": { "type": ["string", "null"] },
            "python": { "type": ["string", "null"] },
            "pytest": { "type": ["string", "null"] },
            "limites": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpus", "memoria", "timeout_s"],
              "properties": {
                "cpus": { "type": "number" },
                "memoria": { "type": "string" },
                "timeout_s": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "caso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "resultado", "duracion_s"],
      "properties": {
        "nombre": { "type": "string" },
        "ruta": { "type": "string" },
        "resultado": { "enum": ["paso", "fallo", "error", "omitido"] },
        "duracion_s": { "type": "number", "minimum": 0 },
        "mensaje": { "type": ["string", "null"] },
        "tipo_error": { "type": ["string", "null"] },
        "archivo": { "type": ["string", "null"] },
        "linea": { "type": ["integer", "null"] },
        "codigo": { "type": ["string", "null"] },
        "operador": { "type": ["string", "null"] },
        "esperado": { "type": ["string", "null"] },
        "obtenido": { "type": ["string", "null"] },
        "traza": { "type": ["string", "null"] },
        "pila": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["archivo", "linea"],
            "properties": {
              "archivo": { "type": "string" },
              "linea": { "type": "integer" },
              "detalle": { "type": "string" },
              "codigo": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Solo se acepta un test que pasó en el sandbox y sin laundering.",
      "if": { "properties": { "decision": { "const": "accept" } } },
      "then": {
        "properties": {
          "estado_sandbox": { "const": "ok" },
          "laundering_detectado": { "const": false }
        }
      }
    },
    {
      "description": "Solo se reintenta un test mal escrito y si queda al menos un intento.",
      "if": { "properties": { "decision": { "const": "retry" } } },
      "then": {
        "properties": {
          "tipo_fallo": { "const": "error_test" },
          "intento": { "maximum": 2 },
          "feedback": { "minLength": 1 }
        }
      }
    },
    {
      "description": "Un bug del código se reporta y no se reintenta (reintentarlo sería Assertion Laundering).",
      "if": { "properties": { "decision": { "const": "bug_detectado" } } },
      "then": {
        "properties": {
          "tipo_fallo": { "const": "bug_codigo" },
          "feedback": { "minLength": 1 }
        }
      }
    }
  ]
}
