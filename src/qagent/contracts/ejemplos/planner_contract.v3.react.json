      "valor_esperado": { "renderiza": true },
      "origen": "tipo",
      "categoria": "limite"
    },
    {
      "id": "pulsar_avisa",
      "descripcion": "El JSDoc dice que avisa con onPulsar al pulsarlo",
      "entrada": {
