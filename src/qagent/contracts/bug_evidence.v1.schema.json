{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bug_evidence.v1.schema.json",
  "title": "bug_evidence.v1",
  "description": "#193. Prueba que detectó un bug, separada de las pruebas aprobadas y vinculada con su corrida y contrato Planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "categoria",
    "creado",
    "run_id",
    "objetivo",
    "archivo_prueba",
    "codigo_prueba",
    "huella_prueba",
    "firma",
    "spec",
    "decision"
  ],
  "properties": {
    "version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "categoria": { "const": "evidencia_bug" },
    "creado": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$" },
    "objetivo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulo", "nombre", "tipo"],
      "properties": {
        "modulo": { "type": "string", "minLength": 1 },
        "nombre": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["funcion", "endpoint"] }
      }
    },
    "archivo_prueba": { "type": "string", "pattern": "^test_[A-Za-z0-9_]+\\.py$" },
    "codigo_prueba": { "type": "string", "minLength": 1 },
    "huella_prueba": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "firma": { "type": "string", "minLength": 1 },
    "spec": { "type": "object" },
    "decision": { "const": "bug_detectado" }
  }
}
